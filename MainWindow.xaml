<Window x:Class="QrCodeRecovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2FA Recovery QrCode - by Dedko Leszek" Height="540" Width="800"
        xmlns:local="clr-namespace:QrCodeRecovery.Helpers"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA KOLUMNA - Dane wejściowe -->
        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="10" 
                Padding="20" 
                Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="Konfiguracja OTP" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20"
                           Foreground="#2C3E50"/>

                <TextBlock Text="Wystawca (Issuer)" 
                           FontWeight="SemiBold" 
                           Foreground="#34495E"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding Wystawca, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10" 
                         Margin="0,0,0,15"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         FontSize="13"/>

                <TextBlock Text="Konto (Account)" 
                           FontWeight="SemiBold" 
                           Foreground="#34495E"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding Konto, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10" 
                         Margin="0,0,0,15"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         FontSize="13"/>

                <!-- Tryb wprowadzania -->
                <TextBlock Text="Tryb wprowadzania" 
                           FontWeight="SemiBold" 
                           Foreground="#34495E"
                           Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Text Phrase" 
                                 IsChecked="{Binding IsRecoveryMode}"
                                 Margin="0,0,15,0"
                                 FontWeight="Bold"/>
                    <RadioButton Content="Recovery Key (Base32)" 
                                 IsChecked="{Binding IsSecretMode}"
                                 Margin="0,0,15,0"
                                 FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="{Binding InputModeDescription}" 
                           FontSize="11" 
                           Foreground="#7F8C8D"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <!-- Fraza / Klucz -->
                <TextBlock Text="Wartosc" 
                           FontWeight="SemiBold" 
                           Foreground="#34495E"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBoxSecret" 
                             PasswordChanged="PasswordBoxSecret_PasswordChanged"
                             Padding="10" 
                             Margin="0,0,0,20"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             FontSize="13"/>
                <Border Background="#F8F9F9"
        BorderBrush="#D5DBDB"
        BorderThickness="1"
        CornerRadius="6"
        Padding="8"
        Margin="0,0,0,15">

                    <Grid Visibility="{Binding IsRecoveryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Generated Base32 Secret"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#566573"/>

                            <TextBlock Text="•••••••• (sekret ukryty)"
                       FontFamily="Consolas"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,4,10,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                Command="{Binding CopySecretCommand}"
                Width="32"
                Height="32"
                Margin="5,0,0,0"
                Cursor="Hand"
                ToolTip="Kopiuj secret">
                            <TextBlock Text="📋"
                       FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- PRAWA KOLUMNA - Wyniki -->
        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="10" 
                Padding="20">
            <StackPanel VerticalAlignment="Top">
                <Border Background="#FAFAFA" 
                        CornerRadius="8" 
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}" 
                           Stretch="Uniform" 
                           Height="215" 
                           Width="215"/>
                </Border>


                <Button Content="Wyczyść dane" Command="{Binding ClearCommand}" Margin="0,8,0,4" Padding="8"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <!-- Kod weryfikacyjny -->

                <Border Background="#E8F8F5" 
                        CornerRadius="8" 
                        Margin="0,10,0,0"
                        Padding="10"
                        BorderBrush="#A3E4D7"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        MinWidth="220">
                    <TextBlock Text="{Binding VerificationCodeFormatted, Mode=OneWay}"
                               FontSize="36" 
                               FontWeight="Bold" 
                               FontFamily="Consolas"
                               Foreground="#1E8449"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding SecondsRemaining, StringFormat='Odswiezenie za {0} s'}" 
           FontSize="11" 
           Foreground="#7F8C8D"
           HorizontalAlignment="Center"
           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>